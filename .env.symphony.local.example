LINEAR_API_KEY=lin_api_replace_me
LINEAR_PROJECT_SLUG=replace-with-linear-project-slug

# Optional: scope polling to a single assignee id (leave empty to disable assignee filtering)
# LINEAR_ASSIGNEE=

# Runtime options
SYMPHONY_AI_ENGINE=claude
SYMPHONY_DASHBOARD_PORT=4040
SYMPHONY_MAX_CONCURRENT_AGENTS=1
SYMPHONY_ALLOW_AUTO_MERGE=0
SYMPHONY_MAX_TURNS=8
SYMPHONY_POLL_INTERVAL_MS=2000

# Mixed engine mode example
# SYMPHONY_AI_ENGINE=mixed
# SYMPHONY_AGENT_ROUTER_MAP=codex:3,opencode:2
# SYMPHONY_AGENT_ROUTER_FALLBACK=codex

# Optional tuning
# CLAUDE_MODEL=claude-opus-4-6
# CLAUDE_NO_OUTPUT_TIMEOUT_SEC=420
# OPENCODE_MODEL=openai/gpt-5
# SYMPHONY_PR_COMMENT_LIMIT=20
# SYMPHONY_LINEAR_COMMENT_LIMIT=20
